# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Network & Connection (Essential for Raspberry Pi / Wi-Fi)
# Increase timeouts if your network has latency connecting to api.telegram.org
TELEGRAM_CONNECT_TIMEOUT=30.0
TELEGRAM_READ_TIMEOUT=30.0
TELEGRAM_WRITE_TIMEOUT=30.0

# Number of bootstrap retries on startup (5 recommended, -1 for infinite retry)
TELEGRAM_BOOTSTRAP_RETRIES=5

# Optional: Proxy (HTTP/SOCKS5) if api.telegram.org is blocked or throttled on your network
# TELEGRAM_PROXY=socks5://127.0.0.1:9050
# TELEGRAM_PROXY=http://127.0.0.1:8080

# Optional: Custom Telegram Bot API server base URL
# TELEGRAM_BASE_URL=https://api.telegram.org/bot

# Scheduler check interval: Thrice a day = every 8 hours (480 minutes)
CHECK_INTERVAL_HOURS=8
CHECK_INTERVAL_MINUTES=480

# Alert on every price change (increases & drops)
ALERT_ON_ANY_PRICE_CHANGE=true

# Path to JSON storage file
STORAGE_FILE=data/storage.json

# Maximum number of price history points to keep per product (saves SD card space & RAM)
MAX_HISTORY_ENTRIES=20

# Max concurrent network requests (2 is optimal for Raspberry Pi 2W to avoid CPU/RAM spikes)
MAX_CONCURRENT_REQUESTS=2

# Request timeout in seconds
REQUEST_TIMEOUT=15.0

# Optional: Amazon Creators API credentials (if available; falls back to HTTP parser if omitted)
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
